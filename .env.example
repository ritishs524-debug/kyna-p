# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Chatbot (Groq) ───────────────────────────────────────────────────────────
# https://console.groq.com/keys
VITE_GROQ_API_KEY=

# ── Cloudinary (image upload) ────────────────────────────────────────────────
# Both values are required for image uploads to work. The `VITE_` prefix is
# mandatory — Vite strips any env var without it, so these are the only way the
# browser can read them.
#
# Where to find them:
#   1. VITE_CLOUDINARY_CLOUD_NAME
#      Cloudinary dashboard → Settings → Account Details → "Cloud name"
#      (a short slug like `dal5pcjeq`, not a URL)
#
#   2. VITE_CLOUDINARY_UPLOAD_PRESET
#      Cloudinary dashboard → Settings → Upload → Upload presets → Add upload preset
#      → Preset type: "Unsigned"
#      → Saving settings: keep the preset's folder access open
#      Copy the preset name you choose (e.g. `kyna_unsigned`).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ── Backend API (optional) ───────────────────────────────────────────────────
# Only needed for services/team/contact persistence.
# Leave blank to use the built-in default in src/lib/api.ts.
# VITE_API_URL=https://your-backend.onrender.com/api
